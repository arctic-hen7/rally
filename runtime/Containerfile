FROM docker.io/library/node:24-alpine AS codex
ARG CODEX_VERSION=0.170.0
WORKDIR /fetch
RUN case "$(uname -m)" in x86_64) arch=x64 ;; aarch64) arch=arm64 ;; *) exit 1 ;; esac \
 && npm pack --silent "@openai/codex@$CODEX_VERSION-linux-$arch" \
 && tar -xzf openai-codex-*.tgz \
 && mv package/vendor/*-linux-musl /opt/codex \
 && rm -rf /opt/codex/bin/codex-code-mode-host /opt/codex/codex-resources/voice

FROM cgr.dev/chainguard/wolfi-base
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true POETRY_SYSTEM_GIT_CLIENT=true
RUN apk add --no-cache git openssh-client \
 && git config --system protocol.ssh.allow never
COPY --from=codex /opt/codex /opt/codex
RUN mkdir -p /usr/local/bin \
 && ln -s /opt/codex/bin/codex /usr/local/bin/codex \
 && ln -s /opt/codex/codex-path/rg /usr/local/bin/rg
WORKDIR /workspace
